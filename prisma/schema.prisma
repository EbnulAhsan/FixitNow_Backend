generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  TECHNICIAN
  ADMIN
}

model User {
  id           String  @id @default(uuid())
  name         String
  email        String  @unique
  password     String
  phone        String?
  address      String?
  profilePhoto String?
  role         Role    @default(CUSTOMER)
  isDeleted    Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
